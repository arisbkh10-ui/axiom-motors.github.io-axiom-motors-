<title>Our Cars — AXIOM MOTORS</title>
<link rel="stylesheet" href="styles.css">
<style>
  .fleet{
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .car-card{ background: var(--bg); display: flex; flex-direction: column; }
  .car-card.wide{ grid-column: span 2; flex-direction: row; }
  .car-photo{ position: relative; overflow: hidden; }
  .car-card .car-photo img{ width: 100%; height: 100%; object-fit: cover; min-height: 260px; }
  .car-card.wide .car-photo{ flex: 1.1; }
  .car-body{ padding: 30px 32px; flex: 1; display: flex; flex-direction: column; }
  .car-cat{ color: var(--blue); font-size: 0.8rem; font-weight: 600; margin-bottom: 8px; }
  .car-body h3{ font-size: 1.35rem; margin-bottom: 4px; }
  .car-tag{ color: var(--text-mute); font-size: 0.88rem; margin-bottom: 16px; }
  .car-body p{ font-size: 0.94rem; margin-bottom: 18px; }
  .specs{ list-style: none; margin: 0 0 22px 0; padding: 0; display: grid; gap: 6px; }
  .specs li{ font-size: 0.86rem; color: var(--text-mute); display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 6px; }
  .specs li span:last-child{ color: var(--text); font-weight: 500; }
  .car-footer{ margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .price{ font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; color: var(--amber); }
  .price small{ display:block; color: var(--text-mute); font-family: 'IBM Plex Sans', sans-serif; font-size: 0.72rem; font-weight: 400; }

  @media (max-width: 860px){
    .fleet{ grid-template-columns: 1fr; }
    .car-card.wide{ grid-column: span 1; flex-direction: column; }
  }
</style>
</head>
